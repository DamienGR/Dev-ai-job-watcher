# Variables d'environnement (SPEC.md §3.5).
# En local : copier en `.env`. Sur le VPS : fichier ~/.config/dev-ai-job-watcher/env de
# `veille`, droits 600 (deploy/vps/README.md). Dans Netlify : INGEST_SECRET et ALERT_NTFY_URL.
# Ne jamais versionner de vraies valeurs. Budget total Netlify : ~4 Ko pour toutes les variables.

# France Travail — API « Offres d'emploi v2 », OAuth2 client_credentials (https://francetravail.io)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Adzuna — API jobs, pays `fr` (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Envoi des agrégats du VPS vers le site (`npm run push`, `PUT /api/ingest/:name`, D33).
# Même valeur côté Netlify (variable du site) et côté VPS. Générer une valeur aléatoire longue,
# ex. `openssl rand -hex 32`.
INGEST_SECRET=
# Adresse du site Netlify, côté VPS, ex. https://dev-ai-job-watcher.netlify.app
SITE_URL=
# Répertoire des stores (`.data` par défaut en local, ~/data sur le VPS via veille-job).
DATA_DIR=

# Alertes ntfy (SPEC.md §10, D38), sur le VPS et dans Netlify (fonction `watchdog`) : adresse
# du sujet, ex. https://ntfy.sh/veille-<aléatoire>. Jeton `tk_…` seulement si le sujet est protégé.
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=

# Sauvegarde de DATA_DIR par restic vers Cloudflare R2 (SPEC.md §3.4, D39), VPS seulement.
# ex. s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/veille-backup ; le mot de passe est aussi
# rangé hors du VPS, sinon la sauvegarde est illisible.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Mode des collecteurs : `live` (défaut, appels réels) ou `fixtures` (réponses enregistrées
# dans `fixtures/`, sans clé d'API ; SPEC.md §13).
SOURCE_MODE=live
