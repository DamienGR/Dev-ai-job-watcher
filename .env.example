# Variables d'environnement (SPEC.md §3.5).
# Copier en `.env` pour `netlify dev` ; en production, les définir dans l'UI Netlify.
# Ne jamais versionner de vraies valeurs. Budget total Netlify : ~4 Ko pour toutes les variables.
# `URL` (URL du site, utilisée pour les appels internes) est fournie automatiquement par Netlify.

# France Travail — API « Offres d'emploi v2 », OAuth2 client_credentials (https://francetravail.io)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Adzuna — API jobs, pays `fr` (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Envoi des agrégats du VPS vers le site (`npm run push`, `PUT /api/ingest/:name`, D33).
# Même valeur côté Netlify (variable du site) et côté VPS. Générer une valeur aléatoire longue,
# ex. `openssl rand -hex 32`.
INGEST_SECRET=
# Adresse du site Netlify, côté VPS, ex. https://dev-ai-job-watcher.netlify.app
SITE_URL=
# Répertoire des stores sur le VPS (`.data` par défaut en local).
DATA_DIR=

# Secret partagé des appels internes vers les fonctions background (en-tête `x-internal-secret`).
# Générer une valeur aléatoire longue, ex. `openssl rand -hex 32`.
INTERNAL_SECRET=

# Jeton exigé par `POST /api/admin/run` (relance manuelle d'une étape).
ADMIN_TOKEN=

# Canal d'alerte (SPEC.md §10) — DÉCISION OUVERTE : ntfy, e-mail ou Slack.
# Les variables `ALERT_*` seront fixées au lot 5 selon le canal retenu.

# Mode des collecteurs : `live` (défaut, appels réels) ou `fixtures` (réponses enregistrées
# dans `fixtures/`, sans clé d'API ; SPEC.md §13).
SOURCE_MODE=live
